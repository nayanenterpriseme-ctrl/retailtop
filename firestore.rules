rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Option 1: Open access for single-user POS (simpler, less secure)
    // Uncomment below and comment out Option 2 if you want anyone with your Firebase config to access
    // match /{document=**} {
    //   allow read, write: if true;
    // }
    
    // Option 2: Authenticated access only (more secure, requires login)
    match /inventory/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /sales/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /customers/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /held_bills/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /returns/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
